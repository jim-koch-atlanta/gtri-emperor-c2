<Application x:Class="operator_gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:operator_gui">
    <!-- No StartupUri: App.OnStartup builds the window so it can inject the feed. -->
    <Application.Resources>
        <!-- ===== react-spike dark tactical palette (GitHub-dark) ===== -->
        <SolidColorBrush x:Key="Brush.Bg"     Color="#0d1117"/>
        <SolidColorBrush x:Key="Brush.Panel"  Color="#1c2128"/>
        <SolidColorBrush x:Key="Brush.Panel2" Color="#10151c"/>
        <SolidColorBrush x:Key="Brush.Border" Color="#30363d"/>
        <SolidColorBrush x:Key="Brush.Text"   Color="#e6edf3"/>
        <SolidColorBrush x:Key="Brush.Muted"  Color="#8b949e"/>
        <SolidColorBrush x:Key="Brush.Accent" Color="#58a6ff"/>
        <SolidColorBrush x:Key="Brush.Live"   Color="#3fb950"/>
        <SolidColorBrush x:Key="Brush.Stale"  Color="#d29922"/>
        <SolidColorBrush x:Key="Brush.Lost"   Color="#f85149"/>

        <!-- ===== small section title ===== -->
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,10"/>
        </Style>

        <!-- ===== dark rounded input ===== -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource Brush.Panel2}"/>
            <Setter Property="Foreground"      Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="7,6"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="CaretBrush"      Value="{StaticResource Brush.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== accent APPLY button ===== -->
        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Brush.Accent}"/>
            <Setter Property="Foreground" Value="#05121F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Padding"    Value="10"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Border}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ghost button (map overlay, e.g. Fit All) ===== -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background"      Value="#B30D1117"/>
            <Setter Property="Foreground"      Value="{StaticResource Brush.Text}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,4"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
