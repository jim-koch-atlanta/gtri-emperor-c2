<Window x:Class="operator_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:operator_gui"
        xmlns:vm="clr-namespace:operator_gui.ViewModels"
        mc:Ignorable="d"
        Title="{Binding StatusText}" Height="450" Width="800"
        Background="{StaticResource Brush.Bg}"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter   x:Key="BoolToVis"/>
        <local:StatusToBrushConverter   x:Key="StatusToBrush"/>
        <local:CmdStateToBrushConverter x:Key="CmdStateToBrush"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />    <!-- The left Roster panel -->
            <ColumnDefinition Width="*" />      <!-- The tactical region takes the rest -->
            <ColumnDefinition Width="260" />    <!-- The command panel -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- main content (your existing stuff stays in row 0) -->
            <RowDefinition Height="140"/>    <!-- command status bar -->
            <RowDefinition Height="Auto"/>   <!-- status bar sizes to content -->
        </Grid.RowDefinitions>
        <ListBox
            Grid.Column="0"
            Grid.Row="0"
            ItemsSource="{Binding Robots}"
            SelectionMode="Extended"
            Background="{StaticResource Brush.Panel}"
            BorderThickness="0"
            Foreground="{StaticResource Brush.Text}">

            <!-- Allow selection on the canvas to result in selection on the Robot Roster panel -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- selection binding — UNCHANGED (drives roster<->canvas sync) -->
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="bd" Background="Transparent"
                                        BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Brush.Panel2}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1F2937"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Ellipse Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                 Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Left"
                                 Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>

                        <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Id}"
                                   FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Status}"
                                   FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}"/>

                        <TextBlock Grid.Column="3" Grid.Row="0" Text="{Binding Age, StringFormat='{}{0} ms'}"
                                   FontSize="11" Foreground="{StaticResource Brush.Muted}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1"
                                    Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Speed,  StringFormat='V {0:0.#}'}"
                                       FontSize="11" Foreground="{StaticResource Brush.Muted}"/>
                            <TextBlock Text="{Binding Radius, StringFormat='R {0:0.#}'}"
                                       FontSize="11" Foreground="{StaticResource Brush.Muted}" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button
            Grid.Column="1"
            Grid.Row="0"
            Content="Fit All" Command="{Binding FitAllCommand}"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="10,4" />

        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="3" VerticalScrollBarVisibility="Auto" Background="#151515">
            <ItemsControl ItemsSource="{Binding Commands}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One Command row -->
                        <StackPanel Orientation="Horizontal" Margin="6,3">
                            <TextBlock Text="{Binding ShortId}" Foreground="#aaa" Width="72" FontFamily="Consolas"/>

                            <!-- For each command, the per-Target chips -->
                            <ItemsControl ItemsSource="{Binding Targets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- One Chip, colored by state -->
                                        <Border CornerRadius="3" Margin="2,0" Padding="5,1"
                                                Background="{Binding State, Converter={StaticResource CmdStateToBrush}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding RobotId}" Foreground="White" FontSize="11"/>
                                                <TextBlock Text="{Binding State}"   Foreground="White" FontSize="11" Margin="4,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Robot Status Count bar -->
        <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Background="#222">
            <TextBlock Text="{Binding StatusText}"                           Foreground="White"     Margin="8,4"/>
            <TextBlock Text="{Binding LiveCount,  StringFormat='LIVE {0}'}"  Foreground="LimeGreen" Margin="8,4"/>
            <TextBlock Text="{Binding StaleCount, StringFormat='STALE {0}'}" Foreground="Gold"      Margin="8,4"/>
            <TextBlock Text="{Binding LostCount,  StringFormat='LOST {0}'}"  Foreground="Red"       Margin="8,4"/>
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Robots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Polyline Points="{Binding Trail}" Stroke="DodgerBlue" StrokeThickness="1" Opacity="0.4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Robots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding CanvasX}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding CanvasY}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid Width="22" Height="22">
                            <Ellipse
                                Width="22" Height="22" Stroke="Yellow" StrokeThickness="2" Fill="Transparent"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>                            
                            <Ellipse
                                Width="14" Height="14" Fill="DodgerBlue"
                                MouseLeftButtonDown="Dot_Click" />
                        </Grid>
                        <TextBlock Text="{Binding Id}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The command panel -->
        <StackPanel Grid.Column="2" Grid.Row="0" Margin="10" Background="#1a1a1a">
            <TextBlock Text="COMMAND" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
            <TextBlock Text="Speed (V)" Foreground="#ccc"/>
            <TextBox Text="{Binding CommandSpeed}"/>
            <TextBlock Text="Radius (R)" Foreground="#ccc" Margin="0,8,0,0"/>
            <TextBox Text="{Binding CommandRadius}"/>
            <Button Command="{Binding ApplyCommand}" Margin="0,12,0,0" Padding="8,4">
                <TextBlock Text="{Binding SelectedRobots.Count, StringFormat='APPLY TO {0} ROBOT(S)'}"/>
            </Button>
        </StackPanel>

    </Grid>
</Window>
