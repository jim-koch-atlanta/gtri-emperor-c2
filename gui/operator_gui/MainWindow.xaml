<Window x:Class="operator_gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:operator_gui"
        xmlns:vm="clr-namespace:operator_gui.ViewModels"
        mc:Ignorable="d"
        Title="{Binding StatusText}" Height="450" Width="800">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:StatusToBrushConverter x:Key="StatusToBrush"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />    <!-- The left Roster panel -->
            <ColumnDefinition Width="*" />      <!-- The tactical region takes the rest -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>      <!-- main content (your existing stuff stays in row 0) -->
            <RowDefinition Height="Auto"/>   <!-- status bar sizes to content -->
        </Grid.RowDefinitions>
        <ListBox
            Grid.Column="0"
            Grid.Row="0"
            ItemsSource="{Binding Robots}"
            SelectedItem="{Binding SelectedRobot, Mode=TwoWay}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Ellipse Width="10" Height="10"
                            Fill="{Binding Status, Converter={StaticResource StatusToBrush}}"/>
                        <TextBlock Text="{Binding Id}"/>
                        <TextBlock Text="{Binding Status}"/>
                        <TextBlock Text="{Binding Age}"/>
                        <TextBlock Text="{Binding Speed}"/>
                        <TextBlock Text="{Binding Radius}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button
            Grid.Column="1"
            Grid.Row="0"
            Content="Fit All" Command="{Binding FitAllCommand}"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="10,4" />

        <!-- Robot Status Count bar -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Background="#222">
            <TextBlock Text="{Binding StatusText}"                           Foreground="White"     Margin="8,4"/>
            <TextBlock Text="{Binding LiveCount,  StringFormat='LIVE {0}'}"  Foreground="LimeGreen" Margin="8,4"/>
            <TextBlock Text="{Binding StaleCount, StringFormat='STALE {0}'}" Foreground="Gold"      Margin="8,4"/>
            <TextBlock Text="{Binding LostCount,  StringFormat='LOST {0}'}"  Foreground="Red"       Margin="8,4"/>
        </StackPanel>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Robots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Polyline Points="{Binding Trail}" Stroke="DodgerBlue" StrokeThickness="1" Opacity="0.4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Robots}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding CanvasX}"/>
                    <Setter Property="Canvas.Top"  Value="{Binding CanvasY}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid Width="22" Height="22">
                            <Ellipse
                                Width="22" Height="22" Stroke="Yellow" StrokeThickness="2" Fill="Transparent"
                                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"/>                            
                            <Ellipse
                                Width="14" Height="14" Fill="DodgerBlue"
                                MouseLeftButtonDown="Dot_Click" />
                        </Grid>
                        <TextBlock Text="{Binding Id}"/>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
