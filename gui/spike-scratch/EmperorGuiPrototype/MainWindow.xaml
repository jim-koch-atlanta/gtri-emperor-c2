<!-- THROWAWAY TEACHING PROTOTYPE — study, then REWRITE in the real spike. Do not copy wholesale.

     The whole tactical view is ~one screen of XAML. Read it top-to-bottom as the
     "WPF in 10 concepts" tour (see MORNING_REPORT.md):
       XAML tree · DataContext · {Binding} · ObservableCollection · DataTemplate
       · Canvas attached props · ItemsPanel override · converters · StringFormat.
     The Dispatcher-marshaling and RenderTransform concepts live in the .cs files. -->
<Window x:Class="EmperorGuiPrototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EmperorGuiPrototype.ViewModels"
        Title="Emperor C2 (prototype)" Height="720" Width="1180"
        Background="#12161C" Foreground="#E6EDF3"
        FontFamily="Segoe UI" FontSize="12">

    <Window.Resources>
        <!-- Built-in converter: maps the bool SelRingVisible -> Visibility. -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- status bar -->
            <RowDefinition Height="*" />      <!-- main 3-pane -->
        </Grid.RowDefinitions>

        <!-- ================= STATUS BAR ================= -->
        <Border Grid.Row="0" Background="#1B2330" Padding="10,6" Margin="0,0,0,8"
                CornerRadius="4">
            <DockPanel>
                <TextBlock Text="SWARM C2" FontWeight="Bold" FontSize="14"
                           Foreground="#8AB4F8" DockPanel.Dock="Left" />
                <!-- StatusSummary = "5 LIVE · 1 STALE · 0 LOST" from the VM -->
                <TextBlock Text="{Binding StatusSummary}" HorizontalAlignment="Right"
                           FontWeight="SemiBold" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- ================= MAIN 3-PANE ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />   <!-- roster -->
                <ColumnDefinition Width="*" />     <!-- tactical -->
                <ColumnDefinition Width="240" />   <!-- selected detail -->
            </Grid.ColumnDefinitions>

            <!-- ===== ROSTER (left) ===== -->
            <Border Grid.Column="0" Background="#161B22" CornerRadius="4" Margin="0,0,8,0">
                <DockPanel>
                    <TextBlock Text="ROSTER" DockPanel.Dock="Top" FontWeight="Bold"
                               Margin="10,8" Foreground="#9DA7B3" />
                    <!-- SelectedItem is two-way bound: roster click updates the VM,
                         and a map-dot click (code-behind) updates the roster here. -->
                    <ListBox ItemsSource="{Binding Robots}"
                             SelectedItem="{Binding SelectedRobot, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="#E6EDF3">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RobotViewModel}">
                                <StackPanel Orientation="Horizontal" Margin="4,3">
                                    <Ellipse Width="10" Height="10" Margin="4,0,8,0"
                                             Fill="{Binding GlyphFill}" />
                                    <TextBlock Text="{Binding RobotId}" Width="46" />
                                    <TextBlock Text="{Binding StatusText}" Width="52"
                                               Foreground="#9DA7B3" />
                                    <TextBlock Text="{Binding AgeText}" Foreground="#9DA7B3" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== TACTICAL VIEW (center) ===== -->
            <Border Grid.Column="1" Background="#0B0F14" CornerRadius="4"
                    ClipToBounds="True">
                <Grid>
                    <!-- The heart of it: an ItemsControl whose ItemsPanel is a Canvas.
                         Each RobotViewModel renders via the DataTemplate below, in
                         absolute SCREEN coordinates the VM already projected. -->
                    <ItemsControl x:Name="Tactical" ItemsSource="{Binding Robots}"
                                  Background="#0B0F14" ClipToBounds="True"
                                  SizeChanged="Tactical_SizeChanged"
                                  MouseWheel="Tactical_MouseWheel"
                                  MouseLeftButtonDown="Tactical_MouseDown"
                                  MouseMove="Tactical_MouseMove"
                                  MouseLeftButtonUp="Tactical_MouseUp">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RobotViewModel}">
                                <!-- Inner Canvas: children use absolute screen coords.
                                     Canvas doesn't clip/measure children, so drawing
                                     outside its 0x0 bounds is fine and expected. -->
                                <Canvas>
                                    <Polyline Points="{Binding TrailPoints}"
                                              Stroke="{Binding GlyphFill}"
                                              StrokeThickness="1.5" Opacity="0.45" />
                                    <Line X1="{Binding ScreenX}" Y1="{Binding ScreenY}"
                                          X2="{Binding HeadingX2}" Y2="{Binding HeadingY2}"
                                          Stroke="{Binding GlyphFill}" StrokeThickness="2" />
                                    <Ellipse Canvas.Left="{Binding SelLeft}" Canvas.Top="{Binding SelTop}"
                                             Width="{Binding SelSize}" Height="{Binding SelSize}"
                                             Stroke="White" StrokeThickness="1.5"
                                             Visibility="{Binding SelRingVisible, Converter={StaticResource BoolToVis}}" />
                                    <Ellipse Canvas.Left="{Binding DotLeft}" Canvas.Top="{Binding DotTop}"
                                             Width="{Binding DotSize}" Height="{Binding DotSize}"
                                             Fill="{Binding GlyphFill}"
                                             Stroke="{Binding GlyphStroke}" StrokeThickness="1.5"
                                             StrokeDashArray="{Binding DashArray}"
                                             Cursor="Hand" MouseLeftButtonDown="Dot_Click" />
                                    <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}"
                                               Text="{Binding RobotId}" FontSize="11" Foreground="#C9D1D9" />
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Overlay: Fit All button. Command bound to the VM (no code-behind). -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                HorizontalAlignment="Left" Margin="8">
                        <Button Content="Fit All" Command="{Binding FitAllCommand}"
                                Padding="12,4" />
                    </StackPanel>
                    <TextBlock Text="scroll = zoom · drag = pan · click a dot or roster row = select"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left"
                               Margin="8" FontSize="10" Foreground="#66C9D1D9" />
                </Grid>
            </Border>

            <!-- ===== SELECTED DETAIL (right) ===== -->
            <Border Grid.Column="2" Background="#161B22" CornerRadius="4" Margin="8,0,0,0">
                <!-- DataContext of this panel = the selected robot VM. When nothing
                     is selected it's null and the FallbackValues show. -->
                <StackPanel DataContext="{Binding SelectedRobot}" Margin="12,10">
                    <TextBlock Text="SELECTED" FontWeight="Bold" Foreground="#9DA7B3" />
                    <TextBlock Text="{Binding RobotId, FallbackValue='(none)'}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,10" />
                    <TextBlock Text="{Binding StatusText, StringFormat='Status:  {0}', FallbackValue=''}" />
                    <TextBlock Text="{Binding AgeText, StringFormat='Age:     {0}', FallbackValue=''}" />
                    <TextBlock Text="{Binding SpeedText, StringFormat='Speed:   {0}', FallbackValue=''}" />
                    <TextBlock Text="{Binding RadiusText, StringFormat='Radius:  {0}', FallbackValue=''}" />

                    <!-- Command panel is a SKETCH ONLY (disabled). Wiring SendCommand
                         needs the live server + the Command Tracker — real-spike work
                         (TECH_SPEC §5). Shown to teach the layout, not to function. -->
                    <Border BorderBrush="#2A3038" BorderThickness="1" CornerRadius="4"
                            Margin="0,16,0,0" Padding="10">
                        <StackPanel IsEnabled="False">
                            <TextBlock Text="COMMAND (sketch — real spike)" FontWeight="SemiBold"
                                       Foreground="#9DA7B3" Margin="0,0,0,6" />
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Speed " Width="52" VerticalAlignment="Center" />
                                <TextBox Text="{Binding SpeedText, Mode=OneWay}" />
                            </DockPanel>
                            <DockPanel Margin="0,2">
                                <TextBlock Text="Radius" Width="52" VerticalAlignment="Center" />
                                <TextBox Text="{Binding RadiusText, Mode=OneWay}" />
                            </DockPanel>
                            <Button Content="APPLY TO 1 ROBOT" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
