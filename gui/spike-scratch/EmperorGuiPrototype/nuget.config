<?xml version="1.0" encoding="utf-8"?>
<!-- THROWAWAY TEACHING PROTOTYPE — study, then REWRITE in the real spike. Do not copy wholesale.
     Local NuGet source: the machine's global NuGet.Config had "No sources found", so
     restore couldn't resolve Grpc.* packages. Scoped here (not the user-global config)
     to honor the overnight session's containment rule. The real spike should confirm the
     team's canonical feed instead of pinning nuget.org here. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
